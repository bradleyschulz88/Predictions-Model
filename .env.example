# Supabase (https://supabase.com/dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel frontend build (public — exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated origins allowed to call the API (include local + production URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8765,https://your-app.vercel.app

# Stripe (Phase 3 — optional for Phase 1)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ---------------------------------------------------------------------------
# Prediction model — local runs only. In CI these come from repo secrets
# (Settings > Secrets and variables > Actions), never from a file.
# ---------------------------------------------------------------------------

# NVIDIA NIM. Optional: without it the injury scorer falls back to its
# deterministic score and the build is unaffected. Get one at build.nvidia.com.
NVIDIA_API_KEY=nvapi-...

# Override the model if you want. Default is meta/llama-3.1-8b-instruct, chosen
# because the task is "rate this 0-3", not reasoning -- a large reasoning model
# answers no better, is far slower, and burns the free tier in fewer calls.
# NVIDIA_INJURY_MODEL=meta/llama-3.1-8b-instruct

# YouTube team news (youtube_intel.py). Local only -- YouTube blocks datacenter
# IPs for transcripts, so this cannot run in CI.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
